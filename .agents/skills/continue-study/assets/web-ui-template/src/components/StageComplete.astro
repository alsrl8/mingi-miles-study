---
import type { LessonStage } from '../lib/progress';

interface Props {
  lessonId: string;
  stage: LessonStage;
  label: string;
}

const { lessonId, stage, label } = Astro.props;
---

<label class="stage-complete">
  <input
    type="checkbox"
    data-stage-checkbox={stage}
    data-lesson-id={lessonId}
  />
  <span>{label}</span>
</label>
